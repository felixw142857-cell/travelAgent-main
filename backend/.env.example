# 本文件属于 Python 后端，不会由 Vite 打包到浏览器。
APP_TITLE=Travel Agent API
APP_DESCRIPTION=旅行规划助手：需求分析、天气查询、多代理编排与行程生成
PROJECT_NAME=travel-agent-backend
VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO
DOCS_ENABLED=true

# 允许访问后端的前端地址；多个地址使用英文逗号分隔。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 模型及工具仅由 Python 服务端调用。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
APP_TIMEZONE=Asia/Shanghai
LLM_TIMEOUT_SECONDS=60
PLAN_TIMEOUT_SECONDS=240
MAX_TOOL_ROUNDS=6

QWEATHER_API_KEY=
QWEATHER_API_HOST=
# 默认使用官方当前的经纬度预报接口；老账号也可切换 v7。
QWEATHER_API_VERSION=v1
QWEATHER_FORECAST_DAYS=30d
WEATHER_TIMEOUT_SECONDS=10
# continue：天气失败时标记缺失，继续规划；error：立即返回错误。
WEATHER_FAILURE_MODE=continue
